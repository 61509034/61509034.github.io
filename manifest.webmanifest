{
  "name": "长弓毅行",
  "short_name": "长弓毅行",
  "description": "简单好用的手动与语音记账工具，支持中文语音录入",
  "start_url": "./?utm_source=pwa",
  "scope": "./",
  "id": "com.changgongyixing.ledger",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#fffaf2",
  "theme_color": "#fffaf2",
  "lang": "zh-CN",
  "categories": ["finance", "lifestyle"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "记一笔",
      "short_name": "记账",
      "description": "快速新增一笔账目",
      "url": "./?action=add",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "查看统计",
      "short_name": "统计",
      "description": "查看本月支出分类",
      "url": "./?tab=stats",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ]
}
